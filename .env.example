# Required backend configuration. Copy to .env; never commit filled values.
PORT=8787
AGENTGUARD_API_KEY=
AGENT_RUNTIME=local
TARGET_PROVIDER=neon

# OpenAI-compatible LLM endpoint. Use the Neon AI Gateway: OPENAI_BASE_URL=<gateway branch host>/v1 and
# OPENAI_API_KEY=<gateway token>. Leave OPENAI_BASE_URL empty to use https://api.openai.com/v1.
# Legacy names NEON_AI_GATEWAY_BASE_URL (bare host, no /v1) + NEON_AI_GATEWAY_TOKEN are still accepted as a fallback.
OPENAI_BASE_URL=https://YOUR-BRANCH-api.ai.YOUR-REGION.aws.neon.tech/v1
OPENAI_API_KEY=
# Models must support tool_calls; verified on the gateway: gpt-5, gpt-5-mini, gpt-5-4-mini.
OPENAI_MODEL=gpt-5
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_TARGET_MODEL=gpt-5-mini

CLICKHOUSE_URL=https://YOUR-HOST.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=albert

# Optional Akash target/attack generation; required only for TARGET_PROVIDER=akash.
AKASHML_API_KEY=
AKASH_API_KEY=
AKASHML_MODEL=openai/gpt-oss-120b
TARGET_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Optional sponsors and storage.
SEMGREP_API_KEY=
SENSO_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
GUILD_WORKSPACE=
GUILD_REDTEAM_KEY_ID=
GUILD_REDTEAM_KEY_SECRET=
GUILD_FIXER_KEY_ID=
GUILD_FIXER_KEY_SECRET=

# GITHUB_TOKEN is supplied by Actions. Store a separate app token as GH_APP_TOKEN
# only when the running demo needs to create PRs/issues outside Actions.
GITHUB_TOKEN=
GH_APP_TOKEN=
GITHUB_REPO=prathamsnehi/cyberdefense-hack-26
GH_REPO_NAME=
PUBLIC_URL=
SEMGREP_BIN=semgrep
LOAD_RATE=5000
